<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/host_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/host_desc"
        android:textSize="14sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/host_pin_label"
        android:textSize="14sp"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="000000"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:letterSpacing="0.3"
        android:layout_marginTop="4dp" />

    <CheckBox
        android:id="@+id/cbApproval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cb_approval"
        android:checked="true"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnStartShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_start_share"
        android:layout_marginTop="20dp"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnStopShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_stop_share"
        android:enabled="false"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvHostStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/host_status"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="20dp" />
</LinearLayout>
